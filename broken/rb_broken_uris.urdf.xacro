<?xml version="1.0"?>
<!--
  Modelo roto A PROPÓSITO para el micro-reto "encuentra el fallo".
  Tres problemas que el preflight del Model Importer debería detectar:
    1. URI package:// que no se resuelve (paquete inexistente)
    2. material script de Ogre 1 (.material) que gz-sim con Ogre 2 no carga
    3. malla en la geometría de colisión
  El robot sigue siendo importable: la idea es leer el informe, no arreglarlo.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rb_broken">

  <link name="base_link">
    <visual>
      <geometry>
        <!-- (1) este paquete no existe en el workspace -->
        <mesh filename="package://paquete_que_no_existe/meshes/chasis.dae"/>
      </geometry>
      <material name="chasis_material">
        <!-- (2) material de Ogre 1 -->
        <texture filename="package://rb_broken_description/materials/scripts/robotnik.material"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <!-- (3) colisión por malla -->
        <mesh filename="package://paquete_que_no_existe/meshes/chasis_collision.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.8"/>
    </inertial>
  </link>

  <link name="sensor_link">
    <visual>
      <geometry><box size="0.1 0.1 0.08"/></geometry>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_link"/>
    <origin xyz="0.2 0 0.25" rpy="0 0 0"/>
  </joint>

  <gazebo reference="sensor_link">
    <sensor name="front_laser" type="gpu_lidar">
      <topic>broken/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <lidar>
        <scan><horizontal><samples>360</samples><min_angle>-3.14</min_angle><max_angle>3.14</max_angle></horizontal></scan>
        <range><min>0.1</min><max>10.0</max></range>
      </lidar>
    </sensor>
  </gazebo>

</robot>
