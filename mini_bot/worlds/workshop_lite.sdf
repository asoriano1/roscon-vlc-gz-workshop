<?xml version="1.0" ?>
<!-- workshop_lite.sdf: workshop.sdf sin el panel de Robotnik (y sin sombras, como workshop.sdf).
     Para portátiles muy justos y para el extra de Robotnik. Mismo world name ("workshop"). -->
<!--
  Robotnik-branded test world for gz_model_importer — Gazebo Harmonic (gz-sim 8)

  Same sensor plugin stack as importer_test.sdf, plus a Robotnik logo panel:
    - White backdrop (8 m × 3 m) at Y=10
    - Three red sphere dots in a downward-pointing triangle (the Robotnik mark)
    - "ROBOTNIK" spelled in dark relief boxes (pixel-font, one model / 34 visuals)

  Launch:
    gz sim test/worlds/robotnik_world.sdf

  Or via ros_gz_sim:
    ros2 launch ros_gz_sim gz_sim.launch.py \
      gz_args:="-r $(pwd)/test/worlds/robotnik_world.sdf"
-->
<sdf version="1.9">
<world name="workshop">

  <!-- ============================================================
       PHYSICS
  ============================================================ -->
  <physics name="1ms" type="ignored">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
  </physics>

  <!-- ============================================================
       WORLD SYSTEM PLUGINS
  ============================================================ -->

  <plugin filename="gz-sim-physics-system"
          name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system"
          name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system"
          name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system"
          name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
  <plugin filename="gz-sim-imu-system"
          name="gz::sim::systems::Imu"/>
  <plugin filename="gz-sim-navsat-system"
          name="gz::sim::systems::NavSat"/>
  <plugin filename="gz-sim-contact-system"
          name="gz::sim::systems::Contact"/>

  <!-- ============================================================
       SCENE
  ============================================================ -->

  <light name="sun" type="directional">
    <cast_shadows>false</cast_shadows>  <!-- sombras fuera: -34 % de CPU del servidor; con sombras: workshop_showcase.sdf -->
    <pose>0 0 10 0 0 0</pose>
    <diffuse>0.8 0.8 0.8 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <direction>-0.5 0.1 -0.9</direction>
    <attenuation>
      <range>1000</range>
      <constant>0.9</constant>
      <linear>0.01</linear>
      <quadratic>0.001</quadratic>
    </attenuation>
  </light>

  <!-- Fill light facing the panel from the front so the relief reads clearly -->
  <light name="panel_fill" type="point">
    <pose>0 5 3 0 0 0</pose>
    <diffuse>0.6 0.6 0.6 1</diffuse>
    <specular>0.1 0.1 0.1 1</specular>
    <attenuation>
      <range>30</range>
      <constant>0.5</constant>
      <linear>0.05</linear>
      <quadratic>0.002</quadratic>
    </attenuation>
    <cast_shadows>false</cast_shadows>
  </light>

  <!-- Ground plane -->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>



  <!-- ============================================================
       LIDAR TARGETS
       Same obstacles as importer_test.sdf so imported robot sensors
       get non-trivial scan readings.
  ============================================================ -->

  <model name="wall_east">
    <static>true</static>
    <pose>0 5 0.5 0 0 0</pose>
    <link name="link">
      <visual name="v">
        <geometry><box><size>4 0.2 1</size></box></geometry>
        <material><ambient>0.1 0.4 0.6 1</ambient><diffuse>0.1 0.4 0.6 1</diffuse></material>
      </visual>
      <collision name="c">
        <geometry><box><size>4 0.2 1</size></box></geometry>
      </collision>
    </link>
  </model>

  <model name="box_obstacle_1">
    <static>true</static>
    <pose>2 1 0.25 0 0 0</pose>
    <link name="link">
      <visual name="v">
        <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="c">
        <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
      </collision>
    </link>
  </model>

  <model name="box_obstacle_2">
    <static>true</static>
    <pose>-2 -1.5 0.3 0 0 0.4</pose>
    <link name="link">
      <visual name="v">
        <geometry><box><size>0.4 0.8 0.6</size></box></geometry>
        <material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.2 0.7 0.2 1</diffuse></material>
      </visual>
      <collision name="c">
        <geometry><box><size>0.4 0.8 0.6</size></box></geometry>
      </collision>
    </link>
  </model>

  <model name="cylinder_obstacle">
    <static>true</static>
    <pose>3 -2 0.4 0 0 0</pose>
    <link name="link">
      <visual name="v">
        <geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
        <material><ambient>0.7 0.7 0.1 1</ambient><diffuse>0.7 0.7 0.1 1</diffuse></material>
      </visual>
      <collision name="c">
        <geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
      </collision>
    </link>
  </model>

</world>
</sdf>
