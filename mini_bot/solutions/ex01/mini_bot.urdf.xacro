<?xml version="1.0"?>
<!--
  mini_bot — robot del taller, versión completa (ejercicio 5).
  Geometría primitiva a propósito: sin mallas, pocos polígonos y sensores de baja
  resolución, para que Gazebo vaya fluido incluso sin GPU.

  Capas:
    ex01  geometría (base, ruedas, rueda loca)
    ex03  sensores de Gazebo (LiDAR y cámara)
    ex05  ros2_control + plugin gz_ros2_control

  Args:
    namespace  prefijo de topics y nodos ROS 2        (por defecto: vacío)
    prefix     prefijo de nombres de links = frames de TF (por defecto: vacío)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mini_bot">

  <xacro:arg name="namespace" default=""/>
  <!-- prefix va solo en los links (son los frames de TF), con la forma que espera ros2_control:
       namespace + barra (robot_a/). Los joints no lo llevan: viven dentro del robot, que ya tiene
       su namespace, y controllers.yaml los nombra sin prefijo. -->
  <xacro:arg name="prefix"    default=""/>
  <xacro:property name="ns"     value="$(arg namespace)"/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <xacro:include filename="$(find mini_bot)/urdf/inertials.xacro"/>

  <!-- Medidas del robot, en un solo sitio -->
  <xacro:property name="base_x"      value="0.40"/>
  <xacro:property name="base_y"      value="0.30"/>
  <xacro:property name="base_z"      value="0.10"/>
  <xacro:property name="base_mass"   value="5.0"/>
  <xacro:property name="wheel_r"     value="0.06"/>
  <xacro:property name="wheel_l"     value="0.04"/>
  <xacro:property name="wheel_mass"  value="0.5"/>
  <xacro:property name="wheel_sep"   value="0.34"/>   <!-- separación entre ruedas -->
  <xacro:property name="caster_r"    value="0.03"/>

  <material name="body_grey"><color rgba="0.25 0.27 0.30 1.0"/></material>
  <material name="accent_red"><color rgba="0.78 0.21 0.18 1.0"/></material>
  <material name="dark"><color rgba="0.10 0.10 0.12 1.0"/></material>

  <!-- ============================ GEOMETRÍA (ex01) ============================ -->

  <link name="${prefix}base_footprint"/>

  <link name="${prefix}base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_x}" y="${base_y}" z="${base_z}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child  link="${prefix}base_link"/>
    <origin xyz="0 0 ${wheel_r + base_z/2 - 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- Una macro para las dos ruedas: cambia el lado y el signo de la Y -->
  <xacro:macro name="wheel" params="side reflect">
    <link name="${prefix}${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_l}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_l}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_r}" l="${wheel_l}"/>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}${side}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_sep/2} ${-base_z/2 + 0.02}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.01"/>
    </joint>
  </xacro:macro>

  <xacro:wheel side="left"  reflect="1"/>
  <xacro:wheel side="right" reflect="-1"/>

  <link name="${prefix}caster_link">
    <visual>
      <geometry><sphere radius="${caster_r}"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_r}"/></geometry>
    </collision>
    <xacro:sphere_inertia m="0.2" r="${caster_r}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child  link="${prefix}caster_link"/>
    <origin xyz="${base_x/2 - 0.05} 0 ${-base_z/2 - caster_r + 0.03}" rpy="0 0 0"/>
  </joint>

  <!-- Rozamiento bajo en la rueda loca, para que no arrastre -->
  <gazebo reference="${prefix}caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="${prefix}left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="${prefix}right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

</robot>
